#
# 194823 tool site (MMR via /api/player, playlike from wiki):
# provider = "194823"
# base_url = "https://194823.xyz"#
# Custom HTTP API: provider = "http", base_url = "https://your-server"
# Local testing: provider = "stub" (uses config/community_stub.json)

[community]
provider = "disabled"
base_url = ""
api_key = ""

